(* EXPECT: OK *)
(* a reader looks, then the memory is written: the order a call evaluates its arguments in *)
Fixpoint total (fuel : nat) (i acc : int) (s : mem) : int :=
  match fuel with O => acc | S f => total f (i + 1) (acc + rd 0 i s) s end.
Definition solve (n : nat) (s : mem) : int := let t := total n 0 0 s in let s1 := upd 1 0 t s in rd 1 0 s1.
