(* EXPECT: OK *)
(* a budget written as a number in the loop, and one more than a budget *)
Fixpoint inner (fuel : nat) (i acc : int) (s : mem) : int :=
  match fuel with O => acc | S f => inner f (i + 1) (acc + rd 0 i s) s end.
Fixpoint outer (fuel n : nat) (i acc : int) (s : mem) : int :=
  match fuel with O => acc | S f => outer f n (i + 1) (acc + inner 20 i 0 s + inner (S n) 0 0 s) s end.
Definition solve (n : nat) (s : mem) : int := outer n n 0 0 s.
