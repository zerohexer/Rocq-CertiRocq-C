(* EXPECT: OK *)
(* a memory given to a reader twice, and read in between *)
Fixpoint total (fuel : nat) (i acc : int) (s : mem) : int :=
  match fuel with O => acc | S f => total f (i + 1) (acc + rd 0 i s) s end.
Fixpoint outer (fuel n : nat) (i acc : int) (s : mem) : int :=
  match fuel with O => acc | S f => outer f n (i + 1) (acc + total n 0 0 s + rd 0 i s + total n 1 0 s) s end.
Definition solve (n : nat) (s : mem) : int := outer n n 0 0 s.
