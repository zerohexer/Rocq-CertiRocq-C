(* EXPECT: REFUSE *)
(* a function is passed as a value inside a loop *)
Fixpoint each (fuel : nat) (g : int -> int) (i acc : int) (s : mem) : int :=
  match fuel with O => acc | S f => each f g (i + 1) (acc + g (rd 0 i s)) s end.
Definition solve (n : nat) (s : mem) : int := each n (fun x => x + 1) 0 0 s.
