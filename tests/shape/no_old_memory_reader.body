(* EXPECT: REFUSE *)
(* the old memory is given to a reader after a write *)
Fixpoint total (fuel : nat) (i acc : int) (s : mem) : int :=
  match fuel with O => acc | S f => total f (i + 1) (acc + rd 0 i s) s end.
Definition solve (n : nat) (s : mem) : int := let s1 := upd 0 0 1 s in total n 0 0 s + rd 0 0 s1.
