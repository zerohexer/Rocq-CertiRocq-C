(* CF235C, written for speed, second version: ONE RECORD PER STATE.
   As the first hand-written version (no pairs, the last state a parameter, no run-time remainder), plus rule 6: what
   is read together sits together.  A state's 26 transitions, its link, its length, its count and its mark are 30
   neighbouring cells of ONE block, where the first version (like the corpus program) keeps them in five blocks -- five
   places in memory to fetch for every step of every walk.  The automaton is larger than the machine's cache, so
   those fetches are what the time goes on. *)
Local Notation rS := 0.
Local Notation rN := 1.      (* state v: cells 30v .. 30v+25 its transitions, then link, length, count, mark *)
Local Notation rST := 5.     (* cell 0: how many states there are *)
Local Notation rBKT := 6.
Local Notation rORD := 7.
Local Notation rQ := 8.
Local Notation rQOFF := 9.
Local Notation rQLEN := 10.
Local Notation rANS := 12.
Local Notation nx v c := (v * 30 + c).
Local Notation lk v := (v * 30 + 26).
Local Notation ln v := (v * 30 + 27).
Local Notation ct v := (v * 30 + 28).
Local Notation vs v := (v * 30 + 29).

(* every state on the way up whose c-transition is q now goes to the clone; then the two links *)
Fixpoint walk_redirect (fuel : nat) (p c q clone cur : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f =>
      if p =? 0 then upd rN (lk cur) clone (upd rN (lk q) clone s)
      else if rd rN (nx p c) s =? q
           then walk_redirect f (rd rN (lk p) s) c q clone cur (upd rN (nx p c) clone s)
           else upd rN (lk cur) clone (upd rN (lk q) clone s)
  end.

(* the clone gets q's 26 transitions and q's link; then the redirection *)
Fixpoint copy_next (fuel n2 : nat) (k q clone p c cur : int) (s : mem) : mem :=
  match fuel with
  | O => walk_redirect n2 p c q clone cur (upd rN (lk clone) (rd rN (lk q) s) s)
  | S f => copy_next f n2 (k + 1) q clone p c cur (upd rN (nx clone k) (rd rN (nx q k) s) s)
  end.

(* from the last state up the links: a state without a c-transition gets one to cur; where that stops decides the rest *)
Fixpoint walk_set (fuel n2 : nat) (p c cur : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f =>
      if p =? 0 then upd rST 0 cur (upd rN (lk cur) 1 s)
      else
        let q := rd rN (nx p c) s in
        if q =? 0 then walk_set f n2 (rd rN (lk p) s) c cur (upd rN (nx p c) cur s)
        else if rd rN (ln p) s + 1 =? rd rN (ln q) s then upd rST 0 cur (upd rN (lk cur) q s)
        else copy_next 26 n2 0 q (cur + 1) p c cur (upd rST 0 (cur + 1) (upd rN (ln (cur + 1)) (rd rN (ln p) s + 1) s))
  end.

Fixpoint build (fuel n2 : nat) (i last : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f =>
      let c := rd rS i s in
      let cur := rd rST 0 s + 1 in
      build f n2 (i + 1) cur (walk_set n2 n2 last c cur (upd rN (ct cur) 1 (upd rN (ln cur) (rd rN (ln last) s + 1) s)))
  end.

Fixpoint bucket (fuel : nat) (v sz : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f => if sz <? v then s else let l := rd rN (ln v) s in bucket f (v + 1) sz (upd rBKT l (rd rBKT l s + 1) s)
  end.

Fixpoint prefix (fuel : nat) (i : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f => prefix f (i + 1) (upd rBKT i (rd rBKT (i - 1) s + rd rBKT i s) s)
  end.

Fixpoint place (fuel : nat) (v : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f =>
      if v <? 1 then s
      else let l := rd rN (ln v) s in let b := rd rBKT l s in place f (v - 1) (upd rORD (b - 1) v (upd rBKT l (b - 1) s))
  end.

Fixpoint propagate (fuel : nat) (i : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f =>
      if i <? 0 then s
      else let v := rd rORD i s in let l := rd rN (lk v) s in propagate f (i - 1) (upd rN (ct l) (rd rN (ct l) s + rd rN (ct v) s) s)
  end.

Fixpoint fall (fuel : nat) (v c : int) (s : mem) : int :=
  match fuel with
  | O => v
  | S f => if v =? 1 then v else if rd rN (nx v c) s =? 0 then fall f (rd rN (lk v) s) c s else v
  end.

Fixpoint shrink (fuel : nat) (v m : int) (s : mem) : int :=
  match fuel with
  | O => v
  | S f => let lk := rd rN (lk v) s in if m <=? rd rN (ln lk) s then shrink f lk m s else v
  end.

(* one pattern: i counts the letters read (twice round, less one), j is where the next letter is; v and l are the
   state and how many letters are matched; the answer goes into its cell when the scan ends *)
Fixpoint scan (fuel n2 : nat) (i j v l off m qid acc : int) (s : mem) : mem :=
  match fuel with
  | O => upd rANS (qid - 1) acc s
  | S f =>
      if 2 * m - 1 <=? i then upd rANS (qid - 1) acc s
      else
        let c := rd rQ (off + j) s in
        let j' := if j + 1 =? m then 0 else j + 1 in
        let v1 := fall n2 v c s in
        let q := rd rN (nx v1 c) s in
        if q =? 0 then scan f n2 (i + 1) j' 1 0 off m qid acc s
        else
          let v2 := shrink n2 q m s in
          let l1 := rd rN (ln v1) s in
          let l2 := rd rN (ln v2) s in
          let lm := (if l <=? l1 then l else l1) + 1 in
          let l' := if lm <=? l2 then lm else l2 in
          if (m <=? l') && negb (rd rN (vs v2) s =? qid)
          then scan f n2 (i + 1) j' v2 l' off m qid (acc + rd rN (ct v2) s) (upd rN (vs v2) qid s)
          else scan f n2 (i + 1) j' v2 l' off m qid acc s
  end.

Fixpoint answer_all (fuel n2 mx : nat) (i : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f => answer_all f n2 mx (i + 1) (scan mx n2 0 0 1 0 (rd rQOFF i s) (rd rQLEN i s) (i + 1) 0 s)
  end.

Definition solve (n n2 q mx : nat) (s : mem) : mem :=
  let s3 := build n n2 0 1 (upd rST 0 1 s) in
  let sz := rd rST 0 s3 in
  answer_all q n2 mx 0 (propagate n2 (sz - 1) (place n2 sz (prefix n 1 (bucket n2 1 sz s3)))).

Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  kq_sum (solve (kq_nat (kq_arg 0)) (kq_nat (kq_arg 1)) (kq_nat (kq_arg 2)) (kq_nat (kq_arg 3)) (kq_input 0)).
