(* CF813F, written for speed, second version.  As the first (one number from `find`, a branch-free merge), plus:
     - rule 6: what the sort compares is IN the cell it moves -- a cell holds (edge) * 2^17 + (time), so the sort
       reads one block where the first version read an index and then looked its key up in another block;
     - rule 1: the size of the undo stack is a parameter of the two loops that change it (`apply`, `rollback`), and
       goes into its cell once, when each of them ends;
     - rule 4: which root goes under which, and which interval a pair of queries gives, are choices between numbers
       inside one call. *)
Local Notation rQX := 0.
Local Notation rQY := 1.
Local Notation rIDX := 3.    (* being sorted: (edge) * 2^17 + (time of the query) *)
Local Notation rTMP := 4.
Local Notation rNH := 5.
Local Notation rRU := 6.
Local Notation rRV := 7.
Local Notation rRN := 8.
Local Notation rST := 9.     (* 0: records made;  1: size of the undo stack;  2: did the last `apply` fit *)
Local Notation rP := 10.
Local Notation rRK := 11.
Local Notation rPX := 12.
Local Notation rSTA := 13.
Local Notation rSTB := 14.
Local Notation rANS := 15.
Local Notation TM := 131071.     (* 2^17 - 1 *)

Fixpoint keys (fuel : nat) (i nz : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f => keys f (i + 1) nz (upd rIDX (i - 1) (((rd rQX i s * (nz + 1) + rd rQY i s) << 17) + i) s)
  end.

Fixpoint merge (fuel : nat) (i j k mid r : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f =>
      if mid <? i then (if r <? j then s else merge f i (j + 1) (k + 1) mid r (upd rTMP k (rd rIDX j s) s))
      else if r <? j then merge f (i + 1) j (k + 1) mid r (upd rTMP k (rd rIDX i s) s)
      else
        let a := rd rIDX i s in
        let b := rd rIDX j s in
        let c := a <=? b in
        merge f (if c then i + 1 else i) (if c then j else j + 1) (k + 1) mid r (upd rTMP k (if c then a else b) s)
  end.

Fixpoint copy_back (fuel : nat) (k r : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f => if r <? k then s else copy_back f (k + 1) r (upd rIDX k (rd rTMP k s) s)
  end.

Fixpoint msort (h q : nat) (l r : int) (s : mem) : mem :=
  match h with
  | O => s
  | S h' =>
      if r <=? l then s
      else
        let m := (l + r) >> 1 in
        copy_back q l r (merge q l (m + 1) l m r (msort h' q (m + 1) r (msort h' q l m s)))
  end.

Definition push_rec (node u v : int) (s : mem) : mem :=
  let c := rd rST 0 s + 1 in
  upd rST 0 c (upd rNH node c (upd rRN c (rd rNH node s) (upd rRV c v (upd rRU c u s)))).

Fixpoint add_iv (h : nat) (node l r a b u v : int) (s : mem) : mem :=
  match h with
  | O => s
  | S h' =>
      if (b <? l) || (r <? a) then s
      else if (a <=? l) && (r <=? b) then push_rec node u v s
      else
        let m := (l + r) >> 1 in
        add_iv h' (2 * node + 1) (m + 1) r a b u v (add_iv h' (2 * node) l m a b u v s)
  end.

(* two queries next to each other with the same edge: switched on, then off *)
Fixpoint pairs (fuel h : nat) (p qz : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f =>
      if qz <=? p then s
      else
        let k1 := rd rIDX p s in
        let k2 := rd rIDX (p + 1) s in
        let t1 := k1 land TM in
        let x := rd rQX t1 s in
        let y := rd rQY t1 s in
        let same := (p + 1 <? qz) && ((k1 >> 17) =? (k2 >> 17)) in
        pairs f h (if same then p + 2 else p + 1) qz
              (add_iv h 1 1 qz t1 (if same then (k2 land TM) - 1 else qz) x y s)
  end.

Fixpoint init_dsu (fuel : nat) (v : int) (s : mem) : mem :=
  match fuel with
  | O => s
  | S f => init_dsu f (v + 1) (upd rPX v 0 (upd rRK v 0 (upd rP v v s)))
  end.

(* 2 * (the root of v) + (the parity of v against its root) *)
Fixpoint find (fuel : nat) (v par : int) (s : mem) : int :=
  match fuel with
  | O => 2 * v + par
  | S f => let p := rd rP v s in if p =? v then 2 * v + par else find f p (par lxor rd rPX v s) s
  end.

(* root rs goes under root rb with parity px; entry t of the undo stack remembers it, and whether rb's rank grew *)
Definition link (rs rb px t : int) (s : mem) : mem :=
  let grew := if rd rRK rs s =? rd rRK rb s then 1 else 0 in
  upd rSTB t grew (upd rSTA t rs (upd rRK rb (rd rRK rb s + grew) (upd rPX rs px (upd rP rs rb s)))).

(* the undo stack, from size t down to size mark *)
Fixpoint rollback (fuel : nat) (t mark : int) (s : mem) : mem :=
  match fuel with
  | O => upd rST 1 t s
  | S f =>
      if t <=? mark then upd rST 1 t s
      else
        let rs := rd rSTA (t - 1) s in
        let rb := rd rP rs s in
        let g := rd rSTB (t - 1) s in
        rollback f (t - 1) mark (upd rPX rs 0 (upd rP rs rs (upd rRK rb (rd rRK rb s - g) s)))
  end.

(* the edges hung on one node of the tree, one after the other; t: the size of the undo stack.
   Cell 2 of rST: 1 when all of them fitted *)
Fixpoint apply (fuel : nat) (e t : int) (s : mem) : mem :=
  match fuel with
  | O => upd rST 2 1 (upd rST 1 t s)
  | S f =>
      if e =? 0 then upd rST 2 1 (upd rST 1 t s)
      else
        let fu := find 40 (rd rRU e s) 0 s in
        let fv := find 40 (rd rRV e s) 0 s in
        let ru := fu >> 1 in
        let rv := fv >> 1 in
        let px := ((fu lxor fv) land 1) lxor 1 in
        let nx := rd rRN e s in
        if ru =? rv then (if px =? 1 then upd rST 2 0 (upd rST 1 t s) else apply f nx t s)
        else
          let under := rd rRK ru s <? rd rRK rv s in
          apply f nx (t + 1) (link (if under then ru else rv) (if under then rv else ru) px t s)
  end.

Fixpoint dfs (h q : nat) (node l r : int) (s : mem) : mem :=
  match h with
  | O => s
  | S h' =>
      let mark := rd rST 1 s in
      let e0 := rd rNH node s in
      let s1 := apply q e0 mark s in
      let t1 := rd rST 1 s1 in
      if rd rST 2 s1 =? 1 then
        (if l =? r then rollback q t1 mark (upd rANS l 1 s1)
         else
           let m := (l + r) >> 1 in
           rollback q t1 mark (dfs h' q (2 * node + 1) (m + 1) r (dfs h' q (2 * node) l m s1)))
      else rollback q t1 mark s1
  end.

Definition solve (q n : nat) (qz nz : int) (s : mem) : mem :=
  dfs 20 q 1 1 qz (init_dsu n 1 (pairs q 20 0 qz (msort 20 q 0 (qz - 1) (keys q 1 nz s)))).

Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  kq_sum (solve (kq_nat (kq_arg 0)) (kq_nat (kq_arg 1)) (kq_arg 2) (kq_arg 3) (kq_input 0)).
