(* signed division and remainder of numbers of both signs *)
Fixpoint inner (fuel : nat) (i acc : int) (s : mem) : int :=
  match fuel with
  | O => acc
  | S f => let x := rd 0 i s - 500 in
           inner f (i + 1) (acc + PrimInt63.divs x 7 + PrimInt63.mods x 7 * 3 + PrimInt63.divs x (0 - 3)) s
  end.
Fixpoint outer (fuel n : nat) (a : int) (s : mem) : int :=
  match fuel with O => a | S f => outer f n (inner n 0 a s) s end.
Definition solve (r n : nat) (nz : int) (s : mem) : int := outer r n 0 s.

Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  solve (kq_nat (kq_arg 0)) (kq_nat (kq_arg 1)) (kq_arg 1) (kq_input 0).
