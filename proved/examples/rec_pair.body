(* a pair as the state of a loop, a helper that gives a pair, fst and snd *)
Definition split (x : int) : int * int := (x >> 5, x land 31).
Fixpoint inner (fuel : nat) (i : int) (p : int * int) (s : mem) : int :=
  match fuel with
  | O => fst p + snd p
  | S f => let '(h, l) := split (rd 0 i s) in
           inner f (i + 1) (fst p + h, snd p + l) s
  end.
Fixpoint outer (fuel n : nat) (a : int) (s : mem) : int :=
  match fuel with O => a | S f => outer f n (inner n 0 (0, a) s) s end.
Definition solve (r n : nat) (nz : int) (s : mem) : int := outer r n 0 s.

Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  solve (kq_nat (kq_arg 0)) (kq_nat (kq_arg 1)) (kq_arg 1) (kq_input 0).
