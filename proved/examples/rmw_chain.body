(* Fourteen read-modify-write steps in one straight run, each reading the memory it writes (the text of the memory would
   double per step written out): the proof names the memory after each step.  Block 0 starts as 32 zeros, so cell i ends
   as 1 + 2 + .. + i and the answer is 105. *)
Definition bump (i : int) (s : mem) : mem := upd 0 i (rd 0 (i - 1) s + i) s.
Definition solve (s : mem) : int :=
  let s := bump 1 s in
  let s := bump 2 s in
  let s := bump 3 s in
  let s := bump 4 s in
  let s := bump 5 s in
  let s := bump 6 s in
  let s := bump 7 s in
  let s := bump 8 s in
  let s := bump 9 s in
  let s := bump 10 s in
  let s := bump 11 s in
  let s := bump 12 s in
  let s := bump 13 s in
  let s := bump 14 s in
  rd 0 14 s.

Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  solve (kq_input 0).
