(* A helper that writes the memory (read-modify-write steps, ten in one straight run) used by a function that gives back a
   number: the function writes the memory too, which is found by looking into the helper.  Block 0 starts as 16 zeros, so
   cell i ends as 1 + 2 + .. + i and the answer is 55. *)
Definition bump (i : int) (s : mem) : mem := upd 0 i (rd 0 (i - 1) s + i) s.
Definition solve (s : mem) : int :=
  let s := bump 1 s in
  let s := bump 2 s in
  let s := bump 3 s in
  let s := bump 4 s in
  let s := bump 5 s in
  let s := bump 6 s in
  let s := bump 7 s in
  let s := bump 8 s in
  let s := bump 9 s in
  let s := bump 10 s in
  rd 0 10 s.

Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  solve (kq_input 0).
