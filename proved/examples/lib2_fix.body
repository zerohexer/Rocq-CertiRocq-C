(* ordinary spellings.  up 3 0 = 4, pick false 5 = 10, dcd 3 7 9 = 7, cmp 3 = 3, lst 1 = 123, opt 1 = 2.
   4000000 + 100000 + 7000 + 1230 + 3 + 2 = 4108235. *)
Definition cell := int.
Fixpoint up (m : nat) (x : cell) : cell := let y := x + 1 in match m with O => y | S q => up q y end.
Definition pick (c : bool) (x : int) : int := (if c then (fun v : int => v + 1) else (fun v : int => v * 2)) x.
Definition dcd (n : nat) (a b : int) : int := if Nat.eq_dec n 3 then a else b.
Definition cmp (n : nat) : int := match Nat.compare n 2 with Eq => 1 | Lt => 2 | Gt => 3 end.
Definition lst (a : int) : int := List.fold_left (fun acc x => acc * 10 + x) (cons a (cons 2 (cons 3 nil))) 0.
Definition opt (a : int) : int := option_rect (fun _ => int) (fun v => v + 1) 0 (if a <? 0 then None else Some a).
Definition solve (a : int) (s : mem) : int :=
  let n := kq_nat 3 in
  up n a * 1000000 + pick false 5 * 10000 + dcd n 7 9 * 1000 + lst 1 * 10 + cmp n + opt 1.
Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  solve 0 (kq_input 0).
