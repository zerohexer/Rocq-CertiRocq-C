(* a read that takes a proof its index is not negative; a value with its proof; a record holding a proof; a recursion taking a proof of its counter's bound *)
Definition att (i : int) (H : PrimInt63.lesb 0 i = true) (t : mem) : int := rd 0 i t.
Definition clamp (x : int) : {y : int | True} := exist _ (if x <? 0 then 0 else x) I.
Record pos := mkpos { pv : int; pw : int; pp : (0 = 0)%nat }.
Fixpoint walk (k : nat) (H : (k <= 100)%nat) (x : pos) (t : mem) {struct k} : mem :=
  match k as k0 return (k0 <= 100)%nat -> mem with
  | O => fun _ => t
  | S m => fun H0 => walk m (PeanoNat.Nat.le_trans _ _ _ (PeanoNat.Nat.le_succ_diag_r m) H0)
                          (mkpos (pv x + 1) (pw x + pv x) eq_refl) (upd 1 (pv x) (pw x) t)
  end H.
Definition solve (a : int) (s : mem) : int :=
  let t := walk (S (S (S O))) (ltac:(repeat constructor) : (3 <= 100)%nat) (mkpos (proj1_sig (clamp a)) 1 eq_refl) s in
  (if PrimInt63.lesb 0 a as c return PrimInt63.lesb 0 a = c -> int
   then fun H => att a H t * 3 + rd 1 a t * 5 + rd 1 (a + 2) t * 7
   else fun _ => 0) eq_refl.
Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  solve (kq_arg 0) (kq_input 0).
