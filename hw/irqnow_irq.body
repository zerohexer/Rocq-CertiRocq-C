(* hw/irqnow_irq.body -- run AT THE MOMENT an interrupt comes (hw/kq_bare.c calls it from the entry code).  A timer tick
   (vector 32): 1 added, atomically, to the counter the main program waits on, and the interrupt acknowledged to the
   controller.  Answers 0 (handled); any other vector, 1. *)
Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  let v := hw_irq_info 0 in
  let s := kq_input 0 in
  if v =? 32 then
    let s1 := hw_atomic 0 4 (hw_addr 6) 1 3 0 s in
    let s2 := hw_port_out 1 32 32 s1 in
    if rd 3 0 s2 <? 0 then 1 else 0
  else 1.
