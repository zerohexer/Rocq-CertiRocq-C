(* hw/lock.body -- TWO PROCESSORS AND A LOCK.  As hw/smp.body: this program starts the second processor (hw/lock_ap.body) and
   both add 1 to one counter in memory they share, 100 000 times each, with a plain read and a plain write -- but
   each time holding a spinlock (hw/lib.body: lock_take, lock_free), so no update is lost: the counter must be 200 000.
   (hw/smp.body's second counter shows what happens without the lock.)  The memory the two share is narrow block 6, listed
   in kq_shared: the program can reach it only through atomics and by address.  Layout from hw_addr 6: the lock, the
   counter (+4), done (+8), started (+12), go (+16).  Each program keeps the cells it reads into in a wide block of its own
   (block 1 here, block 3 there). *)
Definition kq_shared : list int := [6].
Local Notation SH := 6.
Local Notation LAPIC := 4276092928.          (* 0xFEE00000 *)
Local Notation N := 100000.
Fixpoint spin (f : nat) (s : mem) : mem := match f with O => s | S f => spin f (hw_pause s) end.
Fixpoint wait_flag (f : nat) (a : int) (s : mem) : mem :=
  match f with
  | O => s
  | S f => let s1 := hw_aload 4 a 1 2 s in if rd 1 2 s1 =? 1 then s1 else wait_flag f a (hw_pause s1)
  end.
Fixpoint locked_inc (f : nat) (a : int) (s : mem) : mem :=
  match f with
  | O => s
  | S f =>
      let s1 := lock_take (kq_nat 100000000) a 1 3 s in
      if rd 1 3 s1 =? 0 then
        let s2 := hw_load 4 (a + 4) 1 4 s1 in
        locked_inc f a (lock_free a (hw_store 4 (a + 4) (rd 1 4 s2 + 1) s2))
      else locked_inc f a s1
  end.
Definition main : int :=
  let kq_keep := kq_case (kq_S kq_O) (fun _ => tt) (fun _ => tt) in
  let a := hw_addr SH in
  let s0 := ser_init (x86_setup (kq_input 0)) in
  let s1 := hw_copy 32768 (hw_cpu_code 0) (hw_cpu_code 1) s0 in
  let s2 := spin (kq_nat 1000000) (hw_store 4 (LAPIC + 768) 804096 s1) in      (* INIT, to all the others *)
  let s3 := spin (kq_nat 100000) (hw_store 4 (LAPIC + 768) 804360 s2) in       (* STARTUP at page 8 (0x8000) *)
  let s4 := hw_store 4 (LAPIC + 768) 804360 s3 in                               (* and once more *)
  let s5 := wait_flag (kq_nat 50000000) (a + 12) s4 in
  if rd 1 2 s5 =? 1 then
    let s6 := locked_inc (kq_nat N) a (hw_astore 4 (a + 16) 1 s5) in
    let s7 := wait_flag (kq_nat 2000000000) (a + 8) s6 in
    let s8 := hw_aload 4 (a + 4) 1 1 s7 in
    let c := rd 1 1 s8 in
    let s9 := line 99 110 116 114 c (line 99 112 117 115 2 s8) in
    if c =? 2 * N then 0 else 1
  else
    let s6 := line 99 112 117 115 1 s5 in
    if rd 1 2 s6 =? 1 then 0 else 1.
